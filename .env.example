# Google OAuth (Google Cloud Console > Credentials > OAuth client ID > Web application)
# Authorized redirect URI: http://localhost:8788/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth for OneDrive (Azure Portal > App registrations > Web application)
# Authorized redirect URI: http://localhost:8788/auth/microsoft/callback
# Delegated Microsoft Graph permissions: Files.Read.All, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Where the browser app runs (dev server) and where the API runs.
APP_URL=http://localhost:5173
API_URL=http://localhost:8788
PORT=8788

# Persisted sessions and watch history.
DATA_DIR=data

# 1 = preview the UI with fake data and no Google credentials.
MOCK=0
